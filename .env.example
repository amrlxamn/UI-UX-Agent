# Scraper service
SCRAPER_PORT=3000
SCRAPER_LOG_LEVEL=info
AWWARDS_BASE_URL=https://www.awwwards.com
AWWWARDS_USER_AGENT=ui-ux-agent/0.1 (+https://github.com/local/ui-ux-agent)
AWWARDS_REQUEST_TIMEOUT_MS=15000
AWWARDS_RATE_LIMIT_PER_SEC=1

# Postgres (uiux_agent)
POSTGRES_USER=uiux
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uiux_agent

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change-me-32-bytes-base64
N8N_DIAGNOSTICS_ENABLED=false
N8N_CHAT_WORKSPACE_ID=uiux
N8N_CHAT_WEBHOOK_SECRET=change-me
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
GENERIC_TIMEZONE=Asia/Kuala_Lumpur
TZ=Asia/Kuala_Lumpur

# Qdrant
QDRANT_PORT=6333

# Ollama - leave OLLAMA_API_KEY blank to disable cloud and use local only
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
OLLAMA_LOCAL_BASE_URL=http://host.docker.internal:11434/v1

# Model roster (locked in .claude/plans/DECISIONS.md)
OLLAMA_MODEL_PLANNER=glm-5.1:cloud
OLLAMA_MODEL_CODER=minimax-m3:cloud
OLLAMA_MODEL_CRITIC=deepseek-r1:latest
OLLAMA_MODEL_FAST=huihui_ai/qwen3.5-abliterated:2b

# Generator sandbox
SANDBOX_PORT=4000
SANDBOX_BASE_IMAGE=node:20-alpine
